# Server

SERVER_PORT=8080

# MySQL

DB_URL=jdbc:mysql://localhost:3306/edu_flow_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=
DB_PASSWORD=

# Chat / Generate Model - OpenAI compatible

OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash

# Python ML logging: DEBUG / INFO / WARNING / ERROR

ML_LOG_LEVEL=INFO

# Java calls the durable Python scheduling worker over HTTP. In docker-compose
# this is http://ml-api:8000; for local development it is usually localhost.

ML_API_URL=http://localhost:8000

# Formal scheduling jobs are rules-only in Phase 1. These paths persist job
# logs, generated drafts and simulation inputs across process restarts.

EDU_FLOW_PIPELINE_TIMEOUT_SECONDS=1800
EDU_FLOW_PIPELINE_LOG_DIR=backend/data/pipeline/jobs
EDU_FLOW_SIMULATION_DIR=backend/data/simulations

# ML model paths (defaults: ml/models/base/ and ml/models/feedback/current/)
#
# ML_BASE_MODEL_PATH=ml/models/base/schedule_ranker_v1.txt
# ML_BASE_FEATURE_SCHEMA_PATH=ml/models/base/feature_schema.json
# ML_FEEDBACK_MODEL_PATH=ml/models/feedback/current/schedule_ranker.txt
# ML_FEEDBACK_FEATURE_SCHEMA_PATH=ml/models/feedback/current/feature_schema.json

# Phase 1 deliberately has no model/GA switch. The formal worker rejects
# trainModel=true and uses exhaustive legal candidates plus bounded local repair.
